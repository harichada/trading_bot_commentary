# =============================================================================
# Rudra Trading Engine — Environment Variables
# Copy to .env_dev, .env_sit, or .env_prod and fill in values.
# These files are encrypted in git via git-crypt.
# =============================================================================

# Schwab API Credentials
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
SCHWAB_ACCOUNT_NUMBER=

# Trading Configuration
TRADING_ENV=paper
PAPER_TRADING=true
MAX_DAILY_LOSS=500
MAX_POSITION_SIZE=5000

# Risk Limits
MAX_POSITIONS=5
MAX_DAILY_LOSS_PERCENT=0.02
EMERGENCY_STOP_LOSS_PERCENT=0.05

# OANDA Forex
OANDA_ENVIRONMENT=practice
OANDA_ACCOUNT_ID=
OANDA_TOKEN=
OANDA_API_KEY=

# Alpaca Paper Trading
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Polygon.io (free tier)
POLYGON_API_KEY=

# Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostgreSQL
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://rudra:PASSWORD@localhost:5432/rudra_dev

# System
LOG_LEVEL=INFO
AUTO_START=false
GAP_FADE_PORT=8003
GAP_FADE_API_KEY=
GAP_FADE_BIND_ALL=1

# OAuth Authentication (leave AUTH_JWT_SECRET empty to disable)
AUTH_JWT_SECRET=
AUTH_FRONTEND_URL=http://localhost:8003
AUTH_ALLOWED_EMAILS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
