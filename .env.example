# Schwab API Credentials (required for live/paper trading)
# Get these from https://developer.schwab.com
SCHWAB_API_KEY=your_api_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_ACCOUNT_NUMBER=your_account_number_here

# Trading mode: paper or live
TRADING_ENV=paper
PAPER_TRADING=true

# API Authentication (recommended for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# When unset, API auth is disabled (dev mode)
TRADING_API_KEY=

# Risk limits
MAX_DAILY_LOSS=500
MAX_POSITION_SIZE=5000
MAX_POSITIONS=5
MAX_DAILY_LOSS_PERCENT=0.02
EMERGENCY_STOP_LOSS_PERCENT=0.05

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO

# Auto-start trading on boot (true/false)
AUTO_START=false
