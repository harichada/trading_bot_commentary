# Trading Dashboard Environment Variables
# Copy this file to .env.local and configure as needed

# Bot API URL (FastAPI trading bot)
# When running Next.js on a different port (e.g. :3000) against the bot on :9000,
# set this to enable cross-origin requests.
# Leave empty or unset when the dashboard is served by the bot itself (same origin).
NEXT_PUBLIC_BOT_URL=http://localhost:9000

# API Key (optional, for authenticated bot endpoints)
# The bot injects this into window.TRADING_API_KEY when serving the dashboard.
# For standalone Next.js dev, you can set it here if needed.
# TRADING_API_KEY=your-api-key-here
