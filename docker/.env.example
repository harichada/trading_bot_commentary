# Trading Bot Environment Configuration
# Copy this to .env and fill in your values

# Trading Mode: simulation, paper, or live
TRADING_MODE=simulation

# API Ports
API_PORT=9000
UI_PORT=8001

# Schwab API Credentials (required for paper/live trading)
SCHWAB_API_KEY=
SCHWAB_API_SECRET=
SCHWAB_ACCOUNT_ID=

# Token file path (for OAuth authentication)
TOKEN_PATH=./token_1.json

# Logging
LOG_LEVEL=INFO

# Database (optional, for production)
POSTGRES_PASSWORD=changeme

# Redis (optional, for caching)
REDIS_URL=redis://redis:6379
