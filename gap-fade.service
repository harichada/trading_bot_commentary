[Unit]
Description=Rudra Trading Engine
After=network.target
OnFailure=gap-fade-notify-failure@%n.service

[Service]
Type=simple
# EDIT THESE for your system:
User=botuser
WorkingDirectory=/home/botuser/claude/trading_bot_commentary
ExecStart=/home/botuser/claude/trading_bot_commentary/venv/bin/python gap_fade_app.py
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# Environment
EnvironmentFile=/home/botuser/claude/trading_bot_commentary/.env

# Logging — stdout/stderr go to journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gap-fade

# Watchdog — systemd kills+restarts if no ping in 120s
WatchdogSec=120

# Resource limits
MemoryMax=2G
CPUQuota=80%

[Install]
WantedBy=multi-user.target
