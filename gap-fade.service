[Unit]
Description=Rudra Trading Engine (Docker)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
OnFailure=gap-fade-notify-failure@%n.service

[Service]
Type=simple
User=nvidia
WorkingDirectory=/home/nvidia/claude/infra

# Use the infra Makefile targets
ExecStartPre=/usr/bin/make deploy-dev
ExecStart=/usr/bin/make logs-dev
ExecStop=/usr/bin/make down-dev
ExecReload=/usr/bin/make restart-dev

Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gap-fade

# Watchdog
WatchdogSec=120

# Resource limits (container limits in docker-compose.yml take precedence)
MemoryMax=5G

[Install]
WantedBy=multi-user.target
